# 依赖、构建与测试产物
node_modules/
.pnpm-store/
dist/
out/
coverage/
*.tsbuildinfo

# 本机环境配置与凭据（保留可提交的配置样例）
.env
.env.*
!.env.example

# 应用运行数据、工作副本、版本与备份
/data/
/.cona/
*.jsonl.trace

# Electron 打包产物
release/
release-*/
build/release/

# 原型阶段代码、合成样例与运行证据仅本机保留、不入库
# 结论与复现说明整理到 OpenSpec change，仓库只保留提案、规范与评审产物。
/prototypes/

# 通用原生构建产物（若将来在仓库内构建原生目标）
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
*.vcxproj.user
*.suo
*.userosscache
*.sln.docstates

# 日志、缓存与临时文件
*.log
.cache/
.tmp/
.tmp-*
_tmp_*
.DS_Store
Thumbs.db
Desktop.ini

# electron-vite / vitest 运行期临时配置
apps/desktop/electron.vite.config.*.mjs
apps/desktop/vitest.config.ts.timestamp-*.mjs
*.timestamp-*.mjs
vitest.config.ts.bak

# 编辑器与 IDE 本地状态
.trae/
.cursor/
.idea/
.claude/
.vscode/
.vs/

# 会话运行数据
.workbuddy/

# 可重跑产物、原型运行证据与实机探针输出
# 需要共享的脱敏结论、手写文档应先整理到正式文档或 OpenSpec change。
/output/

# 评审过程截图（需要提交的验收证据可显式加入）
/docs/reviews/**/*.png

# 个人讨论与设计草稿，沿用参考项目的本地保留方式
# 当前统一设计与讨论纪要位于此处；共享前需整理为正式文档。
/docs/drafts/

# OpenSpec 提案、规范与评审不在忽略范围内。
