# 依赖、构建与测试产物
node_modules/
.pnpm-store/
dist/
out/
coverage/
*.tsbuildinfo

# 本机环境配置与凭据（保留可提交的配置样例）
.env
.env.*
!.env.example

# 应用运行数据、工作副本、版本与备份
/data/
/.cona/
*.jsonl.trace

# Electron 打包产物
release/
release-*/
build/release/

# 原型阶段代码、合成样例与运行证据仅本机保留、不入库
# 结论与复现说明整理到 OpenSpec change，仓库只保留提案、规范与评审产物。
/prototypes/

# 通用原生构建产物（若将来在仓库内构建原生目标）
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
*.vcxproj.user
*.suo
*.userosscache
*.sln.docstates

# 日志、缓存与临时文件
*.log
.cache/
.tmp/
.tmp-*
_tmp_*
.DS_Store
Thumbs.db
Desktop.ini

# electron-vite / vitest 运行期临时配置
apps/desktop/electron.vite.config.*.mjs
apps/desktop/vitest.config.ts.timestamp-*.mjs
*.timestamp-*.mjs
vitest.config.ts.bak

# 编辑器与 IDE 本地状态
.trae/
.cursor/
.idea/
.claude/
.vscode/
.vs/

# 会话运行数据
.workbuddy/

# 可重跑产物、原型运行证据与实机探针输出
# 需要共享的脱敏结论、手写文档应先整理到正式文档或 OpenSpec change。
/output/

# 评审过程记录与截图整体本机保留
/docs/reviews/

# docs：只提交面向使用者／维护者的层（guide / architecture / development / product，以及 docs 地图）
# 工程过程资产（调研、执行方案与报告、协作记录、草稿）仅本机保留、不入库。
/docs/research/
/docs/engineering/
/docs/collab/
/HANDOFF.md

# 个人讨论与设计草稿的本地保留区（2026-10-18 起，原有的统一设计方案与讨论纪要已整理进 docs/product 与 docs/collab/sessions）
/docs/drafts/

# OpenSpec 提案、规范与评审不在忽略范围内。
